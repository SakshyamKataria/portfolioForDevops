// Sole CI/CD for opportfolio — runs on EC2 Jenkins agent with Docker, AWS CLI, and k3s kubectl.

pipeline {
    agent any

    environment {
        AWS_REGION = 'ap-south-1'
        S3_BUCKET = 'sakshyam-portfolio-artifacts'
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        KUBECONFIG = '/etc/rancher/k3s/k3s.yaml'
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                sh 'npm install --legacy-peer-deps'
            }
        }

        stage('Test') {
            steps {
                sh 'npm test -- --watchAll=false --passWithNoTests || echo "No tests found or test failed, continuing..."'
            }
        }

        stage('Build React') {
            steps {
                sh 'npm run build'
            }
        }

        stage('Archive to S3') {
            steps {
                sh 'bash scripts/s3-upload-artifacts.sh ${BUILD_NUMBER} $(git rev-parse --short HEAD)'
            }
        }

        stage('Docker Build') {
            steps {
                sh '''
                  docker build -f docker/frontend/Dockerfile \
                    -t portfolio-frontend:${IMAGE_TAG} .
                  docker build -f docker/status-api/Dockerfile \
                    -t portfolio-status-api:${IMAGE_TAG} docker/status-api
                  
                  docker tag portfolio-frontend:${IMAGE_TAG} portfolio-frontend:latest
                  docker tag portfolio-status-api:${IMAGE_TAG} portfolio-status-api:latest
                '''
            }
        }

        stage('Import to k3s') {
            steps {
                sh '''
                  if command -v k3s &> /dev/null; then
                    docker save portfolio-frontend:${IMAGE_TAG} | sudo k3s ctr images import -
                    docker save portfolio-status-api:${IMAGE_TAG} | sudo k3s ctr images import -
                  else
                    docker save portfolio-frontend:${IMAGE_TAG} | ctr -n k8s.io -a /run/k3s/containerd/containerd.sock images import -
                    docker save portfolio-status-api:${IMAGE_TAG} | ctr -n k8s.io -a /run/k3s/containerd/containerd.sock images import -
                  fi
                '''
            }
        }

        stage('Deploy to k3s') {
            steps {
                sh '''
                  kubectl apply -f k8s/staging/namespace.yaml
                  kubectl apply -f k8s/staging/
                  
                  kubectl set image deployment/portfolio-frontend frontend=portfolio-frontend:${IMAGE_TAG} -n staging
                  kubectl set image deployment/portfolio-status status=portfolio-status-api:${IMAGE_TAG} -n staging
                  
                  kubectl set env deployment/portfolio-status -n staging \
                    BUILD_NUMBER="${IMAGE_TAG}" GIT_COMMIT="$(git rev-parse --short HEAD)"
                  
                  kubectl rollout status deployment/portfolio-frontend -n staging --timeout=120s
                  kubectl rollout status deployment/portfolio-status -n staging --timeout=120s
                '''
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                  sleep 5
                  curl -sf http://localhost/healthz || echo "Frontend healthcheck failed but continuing"
                  curl -sf http://localhost/api/health || echo "API healthcheck failed but continuing"
                '''
            }
        }
    }

    post {
        always {
            echo "Pipeline finished for build ${BUILD_NUMBER}."
        }
    }
}